# Create a strong private token and set it only in your hosting provider's secret settings.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
# In production, list the exact hostname assigned by your host, without https:// or a path.
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional comma-separated browser origins if a supported web client needs them.
ALLOWED_ORIGINS=
